PORT=8602
NODE_ENV=development

# Database Settings (MySQL / PostgreSQL / MongoDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=milestone_projects_db
DB_USER=root
DB_PASSWORD=your_password_here

# JWT Secret (Min 32 characters)
ACCESS_TOKEN_SECRET=replace_with_a_super_secret_high_entropy_32_char_key_12345

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In
APPLE_CLIENT_ID=com.themilestoneprojects.web.auth
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Allowed Frontend Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,https://themilestoneprojects.co.in
COOKIE_DOMAIN=
